# Ambiente local seguro por padrao.
BANCUS_DB_PROVIDER=sqlite
BANCUS_DB_PATH=.runtime/bancus-fraternis.sqlite

# Homologacao PostgreSQL. Preencha somente no gerenciador de segredos do ambiente.
BANCUS_DATABASE_URL=
BANCUS_DB_SSL=require
BANCUS_DB_POOL_MAX=10
BANCUS_DB_CONNECT_TIMEOUT_MS=5000
BANCUS_DB_QUERY_TIMEOUT_MS=10000

# O servidor nunca converte uma falha PostgreSQL em SQLite silenciosamente.
BANCUS_HOST=127.0.0.1
PORT=8080
