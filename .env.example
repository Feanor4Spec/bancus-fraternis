# Perfil produtivo seguro. Preencha segredos somente no gerenciador do ambiente.
BANCUS_DB_PROVIDER=postgresql
BANCUS_DATABASE_URL=
BANCUS_DB_SSL=require
BANCUS_DB_POOL_MAX=10
BANCUS_DB_CONNECT_TIMEOUT_MS=5000
BANCUS_DB_QUERY_TIMEOUT_MS=10000
BANCUS_DB_SEED_USERS=false

# Em production, contas demo sao recusadas e a sessao usa cookie HttpOnly.
BANCUS_AUTH_MODE=production
BANCUS_SESSION_TTL_MINUTES=480
# Hard cap local do guard de login (32..100000, padrao 10000); ao saturar, novas chaves falham fechadas.
BANCUS_AUTH_LOGIN_GUARD_MAX_ENTRIES=10000
BANCUS_AUTH_COOKIE_SECURE=true
BANCUS_PUBLIC_ORIGIN=https://app.exemplo.com.br
# Habilite somente quando o processo aceitar trafego exclusivamente de um proxy confiavel.
BANCUS_TRUST_PROXY=false
BANCUS_TRUSTED_PROXY_IPS=
# Opcional: segredo estavel para pseudonimos de auditoria; se vazio, cada processo gera um valor efemero.
BANCUS_AUTH_AUDIT_HMAC_SECRET=
# Consultor ativo que recebe pedidos de clientes sem vínculo comercial prévio.
# Obrigatório em production para habilitar esse encaminhamento; nunca é aceito do navegador.
BANCUS_PROPOSAL_INTEREST_QUEUE_EMAIL=

# Bootstrap produtivo: injete somente durante `pnpm bootstrap:admin` e remova depois.
BANCUS_BOOTSTRAP_ADMIN_NAME=
BANCUS_BOOTSTRAP_ADMIN_EMAIL=
BANCUS_BOOTSTRAP_ADMIN_PASSWORD=

# O servidor nunca converte uma falha PostgreSQL em SQLite silenciosamente.
BANCUS_HOST=127.0.0.1
PORT=8080

# Demo local explicita (nao use em ambiente publicado):
# BANCUS_DB_PROVIDER=sqlite
# BANCUS_DB_PATH=.runtime/bancus-fraternis.sqlite
# BANCUS_AUTH_MODE=demo
# BANCUS_AUTH_COOKIE_SECURE=false
# BANCUS_PUBLIC_ORIGIN=http://127.0.0.1:8080
